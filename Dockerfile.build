# Build container for Nutanix AIDP-Connector
# This container includes all build tools, dependencies, and test frameworks
# Used for consistent builds, testing, and linting across all environments

FROM python:3.12-slim

# Set working directory
WORKDIR /workspace

# Install system dependencies for building
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    curl \
    jq \
    ca-certificates \
    gnupg \
    lsb-release \
    && rm -rf /var/lib/apt/lists/*

# Install Docker CLI (for docker-in-docker scenarios)
# Using modern method without deprecated apt-key
RUN install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip to latest version
RUN pip install --upgrade pip setuptools wheel

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies (including test dependencies)
RUN pip install --no-cache-dir -r requirements.txt

# Install additional development tools
RUN pip install --no-cache-dir \
    black==24.1.1 \
    flake8==7.0.0 \
    mypy==1.8.0 \
    pylint==3.0.3 \
    bandit==1.7.5

# Copy project code
COPY nutanix_aidp_connector/ /workspace/nutanix_aidp_connector/
COPY tests/ /workspace/tests/
COPY pytest.ini /workspace/
COPY scripts/ /workspace/scripts/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH="/workspace/nutanix_aidp_connector"
ENV PIPELINE_CONFIG="/workspace/nutanix_aidp_connector/config/config.yaml"

# Default command (can be overridden)
CMD ["/bin/bash"]
